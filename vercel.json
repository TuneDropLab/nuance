{
  "outputDirectory": "build/web",
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/auth.html",
      "destination": "/auth.html"
    },
    {
      "source": "/auth",
      "destination": "/auth.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
